generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  passwordHash     String
  transcripts      Transcript[]
  aiGenerations    Int          @default(0)
  aiLastResetAt    DateTime     @default(now())
  createdAt        DateTime     @default(now())
}

model Transcript {
  id            String             @id @default(uuid())
  collegeId     String
  category      String
  gradField     String
  gender        String
  catPercentile String
  workExperience String @default("NA")
  panelSize     Int
  date          DateTime
  verdict       String
  anonymous     Boolean            @default(false)
  contactInfo   String?
  fullText      String?            // Raw unedited transcript text
  questions     QuestionAnswer[]
  
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime           @default(now())
}

model QuestionAnswer {
  id           String     @id @default(uuid())
  q            String
  a            String
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
}

model IpRateLimit {
  ip          String   @id
  generations Int      @default(0)
  lastResetAt DateTime @default(now())
}

model AiPredictionCache {
  id          String   @id @default(uuid())
  profileHash String   @unique
  collegeId   String
  questions   Json
  createdAt   DateTime @default(now())
}
